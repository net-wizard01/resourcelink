# Postgres (matches docker-compose.yml below)
DATABASE_URL=postgres://resourcelink:resourcelink@localhost:5432/resourcelink

# JWT — generate a real one before deploying: `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m

# Server
PORT=3000
NODE_ENV=development

# Ledger policy defaults (see spec)
CREDIT_OVERDRAFT_FLOOR=-10.00
DEFAULT_SEARCH_RADIUS_M=5000